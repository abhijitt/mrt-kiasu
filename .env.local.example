# LTA DataMall account key. Free from https://datamall.lta.gov.sg/
# Without it the app still works; live crowding and service alerts degrade to
# "unavailable" rather than breaking.
LTA_ACCOUNT_KEY=

# Neon Postgres connection string. Stores error reports and submitted platform
# surveys. Unset, the app still runs: reports fall back to the webhook below
# (or a local file in development), and the survey form tells a surveyor it
# cannot accept their work rather than silently dropping it.
#
# Use the POOLED string Neon shows (the host contains "-pooler"): this app
# talks to Postgres over HTTP from serverless functions, where a direct
# connection per instance runs the database out of connections.
#
# Give production and preview DIFFERENT Neon branches, so beta's test
# submissions never land in the real queue. Create the tables once per branch:
#   DATABASE_URL='postgresql://...' npm run migrate:db
DATABASE_URL=

# Where error reports are POSTed as JSON (Slack, Discord, Formspree, an Apps
# Script endpoint — anything that accepts a POST). Unset in production means
# the report form hands the user their text to copy instead of losing it.
REPORT_WEBHOOK_URL=

# Canonical origin for sitemap, robots and Open Graph tags.
# Falls back to the Vercel deployment host, then to localhost.
NEXT_PUBLIC_SITE_URL=

# Only needed to re-run `npm run translate`. Not used at runtime.
OPENROUTER_API_KEY=
